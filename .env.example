# Sharp Sighted Ops — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Database (Neon Postgres) ─────────────────────────────────────────────
# Pooled connection string from Neon dashboard. Used for everything
# except auth adapter, which needs a direct connection.
#
# IMPORTANT: use sslmode=verify-full, not the default sslmode=require.
# Currently they behave the same in pg ≤ 8.x, but pg v9 changes
# sslmode=require to mean "TLS without cert verification" (libpq
# semantics). verify-full preserves full certificate verification
# both today and after the upgrade, and silences the deprecation
# warning the pg library prints at startup.
DATABASE_URL="postgres://user:pass@host/db?sslmode=verify-full&channel_binding=require"

# Direct (unpooled) connection string for Auth.js Postgres adapter.
# Required because the adapter manages its own pool.
DATABASE_URL_UNPOOLED="postgres://user:pass@host-direct/db?sslmode=verify-full&channel_binding=require"

# ─── Auth.js v5 ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical URL of the deployed site (no trailing slash).
# Local: http://localhost:3000
# Prod:  https://ops.sharpsighted.studio
AUTH_URL="http://localhost:3000"

# Trust the host header — required for Auth.js v5 behind Vercel's proxy.
AUTH_TRUST_HOST="true"

# ─── Resend (magic-link email transport) ──────────────────────────────────
# Setup, one-time:
#   1. Create account at https://resend.com
#   2. Add the sending domain (e.g. sharpsighted.studio) at Resend → Domains.
#      Drop the DKIM + SPF + return-path CNAMEs into Namecheap DNS.
#      Wait 5-10 minutes for verification.
#   3. Create an API key at Resend → API Keys (full-send scope).
#
# In dev, you CAN use Resend's onboarding sandbox sender
# (`onboarding@resend.dev`) to skip the DNS step — but emails will only
# deliver to the account owner's email address. For real-user testing
# you need the verified domain.
AUTH_RESEND_KEY=""

# From-address shown in the magic-link email.
# Must use a verified sender domain on Resend.
# Examples:
#   sandbox:      "Sharp Sighted Ops <onboarding@resend.dev>"
#   real domain:  "Sharp Sighted Ops <no-reply@sharpsighted.studio>"
EMAIL_FROM="Sharp Sighted Ops <onboarding@resend.dev>"

# ─── Access control ───────────────────────────────────────────────────────
# Comma-separated list of email addresses allowed to sign in.
# In v1 this is the entire access-control system. Replace with a roles
# table when partner count > ~5.
ALLOWED_EMAILS="dean@sharpsightedstudio.com"

# ─── Google Calendar sync (Phase 6C — optional) ───────────────────────────
# DORMANT until all three of the first vars are set: with them missing, the
# Ops calendar works local-only and every Google hook is a no-op. Full setup
# runbook in docs/google-calendar-setup.md (service account + domain-wide
# delegation in your Workspace admin console).
GOOGLE_SA_CLIENT_EMAIL=""      # ops-sync@<project>.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY=""       # PEM from the SA key JSON (\n escapes are fine)
GOOGLE_IMPERSONATE_EMAIL=""    # the Workspace user to act as, e.g. dean@sharpsightedstudio.com
GOOGLE_CALENDAR_ID=""          # optional; leave empty to find/create "Sharp Sighted"
